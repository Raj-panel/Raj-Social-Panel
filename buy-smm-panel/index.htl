<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buy SMM Panel - Raj SMM Panel</title>
    <link rel="stylesheet" href="buy-smm-panel.css">
</head>
<body>

    <main class="buy-panel-container">
        
        <!-- Hero Section (Style 04 Layout) -->
        <section class="hero-card">
            <div class="hero-content">
                <h1 class="hero-title">Buy <span class="highlight-blue">SMM Panel</span></h1>
                <h2 class="hero-subtitle">Build Your Own Professional SMM Panel</h2>
                <p class="hero-description">
                    Get your own branded SMM Panel with your preferred design, services and domain. Perfect for starting and growing your own social media marketing business.
                </p>
            </div>
            <div class="hero-graphic">
                <div class="graphic-box">
                    <span class="3d-icon">💻🚀</span>
                </div>
            </div>
        </section>

        <!-- Features Grid Section -->
        <section class="features-section">
            <h3 class="section-title">Why Choose Our SMM Panel?</h3>
            
            <div class="features-grid">
                <div class="feature-card">
                    <div class="icon-wrapper">🎨</div>
                    <span class="feature-text">Professional Design</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">📱</div>
                    <span class="feature-text">Mobile Responsive</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">🏷️</div>
                    <span class="feature-text">Custom Branding</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">🌐</div>
                    <span class="feature-text">Custom Domain</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">📸</div>
                    <span class="feature-text">Instagram Services</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">👍</div>
                    <span class="feature-text">Facebook Services</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">▶️</div>
                    <span class="feature-text">YouTube Services</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">🎵</div>
                    <span class="feature-text">TikTok Services</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">👤</div>
                    <span class="feature-text">User Login & Register</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">📋</div>
                    <span class="feature-text">Order Management</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">💳</div>
                    <span class="feature-text">Wallet & Add Funds</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">🔄</div>
                    <span class="feature-text">Payment Integration</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">⚙️</div>
                    <span class="feature-text">Custom Services</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">🚀</div>
                    <span class="feature-text">Future Updates</span>
                </div>
                <div class="feature-card">
                    <div class="icon-wrapper">🎧</div>
                    <span class="feature-text">Dedicated Support</span>
                </div>
            </div>
        </section>

        <!-- CTA & Contact Section (Style 04 Style) -->
        <section class="cta-card">
            <h2 class="cta-heading">Ready to Start Your Own SMM Panel?</h2>
            <p class="cta-subtext">Contact us today to discuss your requirements and get your own professional SMM Panel.</p>
            
            <div class="contact-info-row">
                <div class="info-block">
                    <span class="info-label">Owner</span>
                    <strong class="info-name">Raj Khan</strong>
                </div>
                <div class="info-block">
                    <span class="info-label">WhatsApp</span>
                    <strong class="info-phone">+91 93370 28344</strong>
                </div>
            </div>

            <a href="https://wa.me/919337028344?text=Hello%20Raj%20Khan%2C%20I%20want%20to%20buy%20an%20SMM%20Panel.%20Please%20share%20the%20available%20plans%2C%20features%2C%20pricing%20and%20details." 
               target="_blank" 
               rel="noopener noreferrer" 
               class="whatsapp-button">
                <span class="btn-icon">💬</span> WhatsApp Support
            </a>
        </section>

    </main>

    <script src="buy-smm-panel.js"></script>
